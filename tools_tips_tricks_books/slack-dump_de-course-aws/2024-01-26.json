    {
        "user": "U03S8TF9USK",
        "type": "message",
        "ts": "1706281901.171649",
        "client_msg_id": "C88B3198-96CA-472D-91FB-B98AA5AD938A",
        "text": "Yep, you’ll want to start defining like so:\n```provider \"aws\" {}\nresource \"aws_s3_bucket\" \"data-lake-bucket\" {}\nresource \"aws_s3_bucket_versioning\" \"bucket_versioning\" {}```\nCan also configure Redshift, which is what I used.",
        "team": "T01ATQK62F8",
        "user_team": "T01ATQK62F8",
        "source_team": "T01ATQK62F8",
        "user_profile": {
            "avatar_hash": "9163651d60bc",
            "image_72": "https:\/\/avatars.slack-edge.com\/2024-01-14\/6471261484611_9163651d60bcec9cafea_72.png",
            "first_name": "Jonathon",
            "real_name": "Jonathon Kobyluck",
            "display_name": "Jonathon Kobyluck",
            "team": "T01ATQK62F8",
            "name": "comet.cetera",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "thread_ts": "1706265647.439009",
        "parent_user_id": "U06ADQ65879",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "AkT\/W",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Yep, "
                            },
                            {
                                "type": "text",
                                "text": "you’ll"
                            },
                            {
                                "type": "text",
                                "text": " want to start defining like so:"
                            },
                            {
                                "type": "text",
                                "text": "\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_preformatted",
                        "elements": [
                            {
                                "type": "text",
                                "text": "provider \"aws\" {}"
                            },
                            {
                                "type": "text",
                                "text": "\n"
                            },
                            {
                                "type": "text",
                                "text": "resource \"aws_s3_bucket\" \"data-lake-bucket\" {}"
                            },
                            {
                                "type": "text",
                                "text": "\n"
                            },
                            {
                                "type": "text",
                                "text": "resource \"aws_s3_bucket_versioning\" \"bucket_versioning\" {}"
                            }
                        ],
                        "border": 0
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Can also configure Redshift, which is what I used"
                            },
                            {
                                "type": "text",
                                "text": "."
                            }
                        ]
                    }
                ]
            }
        ]
    },
