    },
    {
        "user": "U030YJBRE20",
        "type": "message",
        "ts": "1675944436.455069",
        "client_msg_id": "53c3e3c4-d9b9-4e52-9ae4-88f40af493ec",
        "text": "In week 4 what AWS alterntatives are you considering for Google Data Studio? I checked Quicksight and it is too expensive for hobby projects.\nMetabase cloud is also expensive and metabase open source with own hosting seems too complicated compared to Google Data Studio.\n\nIn the previous weeks I have not experienced much different in pricing so both vendors could be used for the whole project, but since Google Data Studio is free makes me think that GCP is overall better for small pipelines where BI is needed. Interested in hearing other comments on this",
        "team": "T01ATQK62F8",
        "user_team": "T01ATQK62F8",
        "source_team": "T01ATQK62F8",
        "user_profile": {
            "avatar_hash": "gde9058c7a1f",
            "image_72": "https:\/\/secure.gravatar.com\/avatar\/de9058c7a1f24da9002862ffff80e5f4.jpg?s=72&d=https%3A%2F%2Fa.slack-edge.com%2Fdf10d%2Fimg%2Favatars%2Fava_0014-72.png",
            "first_name": "JaimeRV",
            "real_name": "JaimeRV",
            "display_name": "",
            "team": "T01ATQK62F8",
            "name": "jaime.raldua.veuthey",
            "is_restricted": false,
            "is_ultra_restricted": false
        },
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "JvV",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "In week 4 what AWS alterntatives are you considering for Google Data Studio? I checked Quicksight and it is too expensive for hobby projects.\nMetabase cloud is also expensive and metabase open source with own hosting seems too complicated compared to Google Data Studio.\n\nIn the previous weeks I have not experienced much different in pricing so both vendors could be used for the whole project, but since Google Data Studio is free makes me think that GCP is overall better for small pipelines where BI is needed. Interested in hearing other comments on this"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    {
