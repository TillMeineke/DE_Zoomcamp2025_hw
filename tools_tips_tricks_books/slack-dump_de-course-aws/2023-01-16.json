                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "In AWS to connect to your AWS instance with ssh you can use the following command:\n"
                            },
                            {
                                "type": "text",
                                "text": "ssh -i de-zomcamp.pem ubuntu@ip-address",
                                "style": {
                                    "code": true
                                }
                            },
                            {
                                "type": "text",
                                "text": "\nwhere de-zoomcamp.pem is the key you created when creating your AWS instance\nip-adress is the ip adress of AWS instance. Be aware that it will change everytime you load it"
                            }
                        ]
                    }
                ]
            }
